---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	FirstSpeaker(FirstSpeaker)
	SecondSpeaker(SecondSpeaker)
	EndOfDialogueOutputs(EndOfDialogueOutputs)
	__end__([<p>__end__</p>]):::last
	FirstSpeaker -.-> EndOfDialogueOutputs;
	FirstSpeaker -.-> SecondSpeaker;
	SecondSpeaker -.-> EndOfDialogueOutputs;
	SecondSpeaker -.-> FirstSpeaker;
	__start__ --> FirstSpeaker;
	EndOfDialogueOutputs --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
